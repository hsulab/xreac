units real
atom_style charge
boundary p p p
read_data bulk.initial.data
pair_style reaxff NULL safezone 3 mincap 100
pair_coeff * * ../../data/ffield.AgZnO Zn O
neighbor 2.0 bin
neigh_modify every 1 delay 0 check yes
fix charge all qeq/reaxff 1 0.0 10.0 1.0e-10 reaxff maxiter 1000
thermo 100
thermo_style custom step pe fmax fnorm
thermo_modify lost error flush yes
run 0
print "INITIAL_ENERGY $(pe:%.16g)"
timestep 0.1
min_style fire
min_modify dmax 0.05
minimize 0.0 0.23060548012069 20000 200000
run 0
print "FINAL_ENERGY $(pe:%.16g)"
write_dump all custom bulk.relaxed.dump id type x y z q fx fy fz modify sort id format float %.16g
